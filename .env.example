# Required
DATABASE_URL=
JWT_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay: use TEST keys first. These are server-only (never NEXT_PUBLIC_).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Set true only after test-mode sign-off and account activation.
RAZORPAY_LIVE_ENABLED=false

# Offline cash/bank receipt notifications. These are server-only.
# Resend: verified sending domain and approved sender address.
RESEND_API_KEY=
AIIT_RECEIPT_FROM_EMAIL=
# MSG91 Flow: approved India DLT sender/template mapped as VAR1=receipt, VAR2=amount, VAR3=student.
MSG91_AUTH_KEY=
MSG91_RECEIPT_TEMPLATE_ID=
